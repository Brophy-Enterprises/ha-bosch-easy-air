{
  "manifest_version": 3,
  "name": "Bosch EasyAir Auth Helper",
  "description": "Captures the EasyAir idsmobileapp:// OAuth redirect URL after Bosch/SingleKey sign-in.",
  "version": "0.1.0",
  "icons": {
    "16": "images/icon-16.png",
    "32": "images/icon-32.png",
    "48": "images/icon-48.png",
    "128": "images/icon-128.png"
  },
  "action": {
    "default_title": "Bosch EasyAir Auth Helper",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "images/icon-16.png",
      "32": "images/icon-32.png",
      "48": "images/icon-48.png",
      "128": "images/icon-128.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "permissions": [
    "clipboardWrite",
    "storage",
    "webRequest"
  ],
  "host_permissions": [
    "https://auth.smart-climate-ids.com/*"
  ]
}
